# ShipLink Frontend Environment Variables

# 1. API Configuration
# For local development, this is automatically proxied to localhost:8000
# For production (Vercel/Netlify), set this to your Render/Backend URL:
VITE_API_URL=https://your-shiplink-backend.onrender.com/api/v1

# 2. Firebase Configuration (Mandatory for Production)
# Get these from your Firebase Console -> Project Settings -> General
VITE_FIREBASE_API_KEY=your_production_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
